# Hora (HH:MM, zona horaria del servidor) a la que arranca la tanda diaria
HORA_INICIO=10:00
# Minutos entre publicaciones (se elige un valor aleatorio dentro del rango)
ESPERA_MIN=8
ESPERA_MAX=10
# Fallos seguidos antes de abortar la tanda
MAX_FALLOS_SEGUIDOS=3
# 1 = sin ventana (VPS), 0 = navegador visible para depurar
HEADLESS=1
# Telegram: token del bot (BotFather) y chat donde llegan avisos y resumen diario
TG_TOKEN=
TG_CHAT_ID=
# Hora (HH:MM, hora del servidor) del resumen diario por Telegram
HORA_RESUMEN=21:00

# Supabase (panel web): la clave secreta SOLO va en el VPS, nunca en la web ni en git
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Ruta opcional de la clave privada que descifra las cookies (por defecto config/cookie_private.pem)
COOKIE_PRIVATE_KEY_FILE=
